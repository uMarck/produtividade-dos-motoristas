{
  "name": "alencar-produtividade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "concurrently": "9.2.1",
    "express": "5.1.0",
    "html2canvas": "1.4.1",
    "jspdf": "3.0.3",
    "lucide-react": "0.545.0",
    "mysql2": "3.15.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "xlsx-js-style": "1.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
